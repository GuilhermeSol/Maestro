#!/usr/bin/env bash
# Maestro quick secret check. The Developer runs it before each commit (developer_agent.md 3.5).
# It checks only the STAGED changes of one repo, test files included:
#   - gitleaks --staged                          : known token and key formats
#   - SwiftLint rule sec_hardcoded_secret        : password = "..." style values
# It prints one line and never prints a secret value.
# Exit: 0 = clean, 1 = something found, 2 = Not run (tool missing or error).
# Limit: SwiftLint reads the working-tree copy of each staged .swift file.
# No tool finds personal data (for example a real email). Only a human or agent review does.
set -u
repo="${1:-}"
if [ -z "$repo" ] || ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
  echo "secret-check: Not run — give the repo path: maestro-secret-check <repo path>"; exit 2
fi
repo="$(cd "$repo" && pwd)"
cfg="$HOME/.maestro/agents/swiftlint-security.yml"
ms() { python3 -I -c 'import time;print(int(time.time()*1000))'; }
t0=$(ms); found=(); notrun=()

if command -v gitleaks >/dev/null 2>&1; then
  gl=$(gitleaks git --staged --redact --no-banner --no-color -f json -r - "$repo" 2>/dev/null)
  # Any parse failure must give "Not run", never "clean".
  if out=$(printf '%s' "$gl" | python3 -I -c '
import sys, json
d = json.load(sys.stdin)
for x in d:
    print("gitleaks " + x["RuleID"] + " " + x["File"] + ":" + str(x["StartLine"]))' 2>/dev/null); then
    [ -n "$out" ] && while IFS= read -r l; do found+=("$l"); done <<< "$out"
  else
    notrun+=("gitleaks: report not parsed")
  fi
else
  notrun+=("gitleaks not installed")
fi

if ! command -v swiftlint >/dev/null 2>&1; then
  notrun+=("swiftlint not installed")
elif [ ! -f "$cfg" ]; then
  notrun+=("SwiftLint rules not found at $cfg")
else
  files=$(git -C "$repo" diff --cached --name-only --diff-filter=ACM -- '*.swift')
  if [ -n "$files" ]; then
    err=$(mktemp)
    sl=$(cd "$repo" && git diff --cached --name-only -z --diff-filter=ACM -- '*.swift' | xargs -0 swiftlint lint --config "$cfg" --only-rule sec_hardcoded_secret --reporter json --quiet --no-cache 2>"$err")
    if grep -q "is not a valid rule identifier" "$err"; then notrun+=("SwiftLint: rule ID not valid"); sl="[]"; fi
    rm -f "$err"
    if out=$(printf '%s' "$sl" | python3 -I -c '
import sys, json, os
root = os.path.realpath(sys.argv[1])
d = json.load(sys.stdin)
for x in d:
    print("swiftlint " + x["rule_id"] + " " + os.path.relpath(os.path.realpath(x["file"]), root) + ":" + str(x["line"]))' "$repo" 2>/dev/null); then
      [ -n "$out" ] && while IFS= read -r l; do found+=("$l"); done <<< "$out"
    else
      notrun+=("SwiftLint: report not parsed")
    fi
  fi
fi

t1=$(ms)
if [ ${#found[@]} -gt 0 ]; then
  also=""; [ ${#notrun[@]} -gt 0 ] && also=" | also Not run — $(IFS='; '; echo "${notrun[*]}")"
  echo "secret-check: FOUND ${#found[@]} — $(IFS='; '; echo "${found[*]}")$also ($((t1-t0)) ms)"; exit 1
elif [ ${#notrun[@]} -gt 0 ]; then
  echo "secret-check: Not run — $(IFS='; '; echo "${notrun[*]}") ($((t1-t0)) ms)"; exit 2
else
  echo "secret-check: clean ($((t1-t0)) ms)"; exit 0
fi
